{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { 
      "src": "/api/v1/auth/(.*)", 
      "dest": "index.js", 
      "methods": ["GET", "POST", "OPTIONS"] 
    },
    { 
      "src": "/api/v1/profiles/(.*)", 
      "dest": "index.js", 
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"] 
    },
    { "src": "/(.*)", "dest": "index.js" }
  ]
}